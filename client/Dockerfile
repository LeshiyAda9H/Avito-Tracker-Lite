# client/Dockerfile

# Этап 1: Сборка React-приложения
FROM node:18-alpine AS builder
# Использование легковесного образа Node.js 18 на базе Alpine для минимизации размера контейнера

WORKDIR /app
# Установка рабочей директории внутри контейнера

# Копирование файлов конфигурации зависимостей
COPY package.json package-lock.json ./
# Копирование package.json и package-lock.json для установки зависимостей

RUN npm install
# Установка зависимостей приложения с помощью npm

# Копирование всего исходного кода приложения
COPY . .

# Сборка приложения для продакшен
RUN npm run build
# Выполнение команды сборки (создает оптимизированные файлы в папке dist)

# Этап 2: Настройка Nginx для раздачи собранного приложения
FROM nginx:alpine
# Использование образа Nginx на базе Alpine для статического хостинга

# Копирование собранных файлов из этапа сборки
COPY --from=builder /app/dist /usr/share/nginx/html
# Перенос файлов из папки dist в директорию, обслуживаемую Nginx

# Копирование кастомной конфигурации Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Замена стандартной конфигурации Nginx на пользовательскую (если требуется)

# Открытие порта 80 для веб-доступа
EXPOSE 80

# Запуск Nginx в режиме foreground
CMD ["nginx", "-g", "daemon off;"]
# Запуск Nginx без фонового режима для корректной работы в контейнере


# Предложения по улучшению:
# 1. **Оптимизация размера**: Добавить .dockerignore для исключения ненужных файлов (например, node_modules, .git). ✅ 
# 2. **Кэширование**: Разделить установку зависимостей на два шага (копирование package.json отдельно, затем npm install) для лучшего кэширования.
# 3. **Конфигурация Nginx**: Проверить, что nginx.conf настроен для SPA (редирект на index.html для маршрутов React Router).
# 4. **Переменные окружения**: Добавить поддержку ENV для API_URL в образе, чтобы клиент мог динамически подключаться к серверу.
# 5. **Безопасность**: Добавить HEALTHCHECK для проверки работоспособности Nginx.
